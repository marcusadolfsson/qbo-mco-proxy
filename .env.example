# Copy to companies/<slug>/.env for each QuickBooks company, then fill in.
# The client id/secret come from your Intuit developer app (shared across companies);
# realm id + refresh token are unique per company (see the README for how to get them).
# chmod 600 each real .env. These files are gitignored — never commit them.

QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production
QUICKBOOKS_REALM_ID=
QUICKBOOKS_REFRESH_TOKEN=

# Optional — make a company read-only (get_*/search_* stay available):
# QUICKBOOKS_DISABLE_WRITE=true
# QUICKBOOKS_DISABLE_UPDATE=true
# QUICKBOOKS_DISABLE_DELETE=true
